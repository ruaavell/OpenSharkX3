{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "OpenSharkX3",
  "version": "2.0.3",
  "identifier": "dev.clevs.opensharkx11",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "title": "OpenSharkX3 — Attack Shark X3",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720,
        "decorations": false,
        "backgroundColor": "#070b10",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "Clevs",
    "homepage": "https://github.com/clevim/OpenSharkX11",
    "shortDescription": "Attack Shark X3 için Linux yapılandırıcısı",
    "longDescription": "Attack Shark X3 için yerel Linux yapılandırıcısı: DPI kademeleri, aydınlatma, tuş eşleme, yoklama hızı, tuş tepkisi, profiller, tanılama ve pil telemetrisi. 2.4 GHz alıcı, USB-C ve Bluetooth ile çalışır.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["libusb-1.0-0"],
        "postInstallScript": "../scripts/postinstall-deb.sh",
        "postRemoveScript": "../scripts/postremove-deb.sh"
      }
    }
  }
}
